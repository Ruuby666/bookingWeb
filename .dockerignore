.git
.gitignore
node_modules
vendor
npm-debug.log
yarn-error.log

# Every dotenv variant, not only ".env": the image now COPYs the whole
# project, so .env.production would otherwise be baked into an image layer.
.env
.env.*

# Symlink made by `artisan storage:link`; the Dockerfile recreates it.
public/storage
storage/logs
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
bootstrap/cache/*.php

tests
.github
phpunit.xml
phpstan.neon
pint.json
rector.php
